# Copy to .env.local and fill in. Never commit .env.local.

# Stripe → Dashboard → Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret.
#   Local:      printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#   Production: Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Printify → My profile → Connections → Personal access token
# Scopes needed: shops.read, products.read, orders.read, orders.write
PRINTIFY_API_TOKEN=

# From `npm run printify`
PRINTIFY_SHOP_ID=

# 1 = standard, 2 = priority, 3 = express, 4 = economy (US only)
PRINTIFY_SHIPPING_METHOD=1

# false: orders wait in Printify for your shop's approval setting (default: auto-approve after 24h).
# true:  orders are sent to production immediately after payment.
PRINTIFY_SEND_TO_PRODUCTION=false
